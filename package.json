{
  "name": "agentboard",
  "version": "0.1.0",
  "description": "Agent-first planning board: one item type at any granularity, voice-first mechanics, embedded SQLite",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/possibilities/agentboard.git"
  },
  "type": "module",
  "bin": {
    "agentboard": "./src/main.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
